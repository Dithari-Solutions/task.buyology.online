# ---- Port exposed on the VPS host ----
# 127.0.0.1 means only a reverse proxy on this machine can reach the container.
# Use 0.0.0.0 only if you deliberately want it reachable without TLS.
BIND_ADDRESS=127.0.0.1
WEB_PORT=6061

# Shared docker network with the backend stack. Create it once:
#   docker network create buyology-kanban-shared
SHARED_NETWORK=buyology-kanban-shared

# ---- Where the Spring Boot API lives ----
# Server-side only - the browser never sees this address. The Next.js server proxies
# every /api/* call to it, so the API needs no public exposure and there is no CORS.
# Default resolves the API container by name over the shared docker network.
BACKEND_URL=http://buyology-kanban-api:8080

# ---- Optional: talk to the API straight from the browser instead of proxying ----
# Leave EMPTY to use the built-in proxy (recommended: one origin, no CORS).
# If you set it (e.g. https://api-kanban.buyology.online) it is baked in at BUILD time,
# so it needs `docker compose up -d --build`, and the API must allow this origin.
NEXT_PUBLIC_API_URL=
